                        "if (!ShipInScript(quest_ship)) break;",
                        "if (!ShipInCurScript(quest_ship)) break;",
                        "if (ShipGroup(quest_ship)==GroupEnemies) break;",
                        "counter=counter+1;",
                        "}",
