   "Operations": [
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 0,
     "Pos.y": 200,
     "Parent": -1,
     "#": 24,
     "Code.Type": "Global",
     "Code": [
      "GRun();"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 0,
     "Pos.y": 230,
     "Parent": -1,
     "#": 25,
     "Code.Type": "Init",
     "Code": [
      "SFT('ExpPB: script Init running (turn ' + CurTurn() + ')');"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 300,
     "Pos.y": 30,
     "Parent": -1,
     "#": 27,
     "Code.Type": "Turn",
     "Code": [
      "dtext = '</color>' + CT('FormRuins.PB.AskQuestion.PBAsk');",
      "dtext = Format(dtext);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 300,
     "Pos.y": 90,
     "Parent": -1,
     "#": 29,
     "Code.Type": "Turn",
     "Code": [
      "InjectAnswer('PB_AskQuestion_Cap', '</color>' + CT('FormRuins.PB.AskQuestion.PlayerAskAboutCapture'), 1);",
      "InjectAnswer('PB_AskQuestion_Rank', '</color>' + 'Как заработать пиратский рейтинг?', 2);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 300,
     "Pos.y": 330,
     "Parent": -1,
     "#": 32,
     "Code.Type": "Turn",
     "Code": [
      "dtext = '</color>' + Format(CT('FormRuins.PB.AskQuestion.PBAnswersAboutCapture'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
      "dtext = Format(dtext);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 300,
     "Pos.y": 190,
     "Parent": -1,
     "#": 36,
     "Code.Type": "Turn",
     "Code": [
      "dtext = '</color>' + Format(CT('FormRuins.PB.RankPoints.RankPoints'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
      "dtext = Format(dtext);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 150,
     "Pos.y": 30,
     "Parent": -1,
     "#": 40,
     "Code.Type": "Turn",
     "Code": [
      "n0 = GalaxyMoney(4);",
      "if(ShipOnSidePirateClan(Player())) dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerChangeSideToNormal'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()), '<Cost'+'>', n0);",
      "else dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerChangeSideToPirate'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()), '<Cost'+'>', n0);",
      "dtext = Format(dtext);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 150,
     "Pos.y": 90,
     "Parent": -1,
     "#": 42,
     "Code.Type": "Turn",
     "Code": [
      "InjectAnswer('PB_ChangeSide_Do', '</color>' + CT('FormRuins.PB.ChangeSide.PlayerOk'), 1);",
      "InjectAnswer('PB_ChangeSide_No', '</color>' + CT('FormRuins.PB.ChangeSide.PlayerNo'), 0);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 140,
     "Pos.y": 330,
     "Parent": -1,
     "#": 44,
     "Code.Type": "Turn",
     "Code": [
      "n0 = GalaxyMoney(4);",
      "if(ShipMoney(Player()) >= n0)",
      "{",
      "    ShipMoney(Player(), ShipMoney(Player()) - n0);",
      "    if(ShipOnSidePirateClan(Player()))",
      "    {",
      "        ShipOwner(Player(), ShipPilotRace(Player()));",
      "        dtext = '</color>' + Format(CT('FormRuins.PB.ChangeSide.AnswerPlayerOkNormal'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
      "    }",
      "    else",
      "    {",
