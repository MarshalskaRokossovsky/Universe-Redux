                        "warp_x = int(TextBox(CT('Script.PC_destroyer.SalWarpX')));",
                        "warp_y = int(TextBox(CT('Script.PC_destroyer.SalWarpY')));",
                        "if(DistCoords(warp_x,warp_y,CoordX(Player()),CoordY(Player())) > ShipCustomShipInfoData(Player(),'RefSalamanderEnergy',1)*40) MessageBox(CT('Script.PC_destroyer.SalWarpTooFar'));",
                        "else {",
                        "  ShipCustomShipInfoData(Player(),'RefSalamanderEnergy',1,ShipCustomShipInfoData(Player(),'RefSalamanderEnergy',1)-round(DistCoords(warp_x,warp_y,CoordX(Player()),CoordY(Player()))/40));",
                        "  ShowStaticEffect('TeleportOut_256_30',CoordX(Player()),CoordY(Player()));",
                        "  ShowStaticEffect('TeleportOut_256_30',warp_x,warp_y);",
                        "  OrderNone(Player());",
                        "  ShipSetCoords(Player(),warp_x,warp_y);",
                        "}"
                    ],
                    "#": 165
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -31,
                    "Pos.y": 1580,
