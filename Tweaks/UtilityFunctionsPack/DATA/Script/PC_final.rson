                    "Parent": -1,
                    "Code.Type": "Init",
                    "Code": [
                        "//Универсальный PC_final (UtilityFunctionsPack). Ветки для модов, которым он нужен:",
                        "//  Tweaks\\EndlessGame - финальные диалоги ответом вместо принудительного показа",
                        "//  Tweaks\\BlockPirates - без веток пиратской базы, эфира о победе клана, RCWin4/RCWin5",
                        "//  ShusRangers\\ShuKlissan - без PBWin2/PBWin4/RCWin5, RCWin4 при ранге до 6, запрет клингов на Тортугац",
                        "//  Expansion\\ExpTraitors - приветствия и налоги Нифигаца только при PirateWin 1/2/5",
                        "//  Reflection\\RefAltStartOnlyPirates - без RCWin1, разговор на Рогерии",
                        "//Без этих модов логика ванильная.",
                        "//Флаги модов (для совместимости; ветки проверяют CurrentMods напрямую)",
                        "endlessGameOff = 1; if(CurrentMods('Tweaks\\\\EndlessGame')) endlessGameOff = 0;",
                        "blockPiratesOff = 1; if(CurrentMods('Tweaks\\\\BlockPirates')) blockPiratesOff = 0;",
                        "klissansOff = 1; if(CurrentMods('ShusRangers\\\\ShuKlissan')) klissansOff = 0;"
                    ],
                    "#": 280
                },
