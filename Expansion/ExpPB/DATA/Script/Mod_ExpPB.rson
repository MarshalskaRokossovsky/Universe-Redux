    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1330,
     "Pos.y": 20,
     "Parent": -1,
     "#": 132,
     "Code.Type": "Turn",
     "Code": [
      "n0 = GalaxyStars();",
      "n1 = 0; n2 = 0; n3 = 0;",
      "for(ii = 0; ii < n0; ii = ii + 1)",
      "{",
      "    dwd1 = StarOwner(GalaxyStar(ii));",
      "    if(dwd1 == 2) n1 = n1 + 1;",
      "    else if(dwd1 == 1) n2 = n2 + 1;",
      "    else if(dwd1 == 0) n3 = n3 + 1;",
      "}",
      "if(n0 < 1) n0 = 1;",
      "//Проценты - ТОЛЬКО в Int-переменных: Str t1 давал строковое сравнение (\"3\" >= 100 = истина -> \"вся галактика под нами\")",
      "nraw = int(100.0 * n1 / n0 + 0.5);",
      "fbf = int(100.0 * n2 / n0 + 0.5);",
      "t9 = int(100.0 * n3 / n0 + 0.5);",
      "//Подблок - как в движке (TfRuinsTalk.I_CBWarWithKlingAndCoalition): доминаторов втрое больше Коалиции / наоборот / поровну",
      "if(fbf > t9 * 3) t0 = 'KlingOnly';",
      "else if(fbf * 3 < t9) t0 = 'CoalitionOnly';",
      "else t0 = 'KlingAndCoalition';",
      "//Шкала процентов пиратов - как в движке: 0..9 / 10..22 / 23..35 / 36..59 / 60..89 / 90..99 / 100",
      "if(nraw >= 100) t4 = 'PBAnswerWeControl100Percent';",
      "else if(nraw >= 90) t4 = 'PBAnswerWeControlMore90Percent';",
      "else if(nraw >= 60) t4 = 'PBAnswerWeControlMore70Percent';",
      "else if(nraw >= 36) t4 = 'PBAnswerWeControlMore50Percent';",
      "else if(nraw >= 23) t4 = 'PBAnswerWeControlMore30Percent';",
      "else if(nraw >= 10) t4 = 'PBAnswerWeControlMore10Percent';",
      "else t4 = 'PBAnswerWeControlMore00Percent';",
      "dtext = '</color>' + Format(CT('FormRuins.PB.WarWithKlingAndCoalition.' + t0 + '.' + t4), '<Player'+'>', ShipName(Player()), '<PiratesPercent'+'>', nraw, '<DominatorsPercent'+'>', fbf, '<Percent'+'>', t9);",
      "dtext = Format(dtext);"
     ]
    },
