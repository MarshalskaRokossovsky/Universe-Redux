                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 850,
                    "Pos.y": -550,
                    "Parent": -1,
                    "#": 182,
                    "Total.Lines": 12,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(CurrentMods('Evolution\\\\EvoFemRangers')) {",
                        "//EvoFemRangers: коэффициенты из Lang мода (SpecialAgentsRelations)",
                        "relation_shift=int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.BeingInClanRelation'))*ShipInPirateClan(Player())+agent_counter*int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.CompletedMissionRelation'))+min(5,GetShipPirateRank(Player()))*int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.ForPirateRankRelation'));",
                        "relation_shift=relation_shift+int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.PerPirateRelation'))*player_pirate_kills+int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.PerHelpedFemRanger'))*player_helps;",
                        "relation_shift=relation_shift+int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.PerEachRobbedRelation'))*player_robs+int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.PerKilledTransport'))*player_transport_kills+int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.PerKilledWarrior'))*player_warrior_kills+int(CT('Script.PC_fem_rangers.SpecialAgentsRelations.PerKilledRanger'))*player_ranger_kills;",
                        "} else {",
                        "relation_shift=-30*ShipInPirateClan(Player())+agent_counter*20-min(5,GetShipPirateRank(Player()))*10;",
                        "relation_shift=relation_shift+2*player_pirate_kills+4*player_helps;",
                        "relation_shift=relation_shift-1*player_robs-4*player_transport_kills-8*player_warrior_kills-4*player_ranger_kills;",
                        "}",
                        "max_relation=(1-player_hate)*(100+relation_shift);",
                        "//max_relation=100;//"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 850,
                    "Pos.y": -590,
                    "Parent": -1,
                    "#": 184,
                    "Total.Lines": 28,
                    "Code.Type": "Turn",
                    "Code": [
                        "counter=GalaxyEvents()-1;",
                        "while (counter>=0){",
                        "if (GalaxyEventDate(counter)==CurTurn()){",
                        "if (GalaxyEventType(counter)=='PlayerExtortsMoney'){",
                        "if (GalaxyEventData(counter,1)==t_Transport){",
                        "player_robs=player_robs+1;}}",
                        "if (GalaxyEventType(counter)=='PlayerExtortsGoods'){",
                        "if (GalaxyEventData(counter,1)==t_Transport){",
                        "player_robs=player_robs+1;}}",
                        "if (GalaxyEventType(counter)=='PlayerAcceptsMoneyForTruce'){",
                        "if (GalaxyEventData(counter,1)==t_Transport){",
                        "player_robs=player_robs+1;}}",
                        "}",
                        "if (GalaxyEventDate(counter)<CurTurn()){counter=0;}",
                        "counter=counter-1;}",
                        "player_transport_kills=ShipStatistic(Player(),4);",
                        "player_pirate_kills=ShipStatistic(Player(),1);",
                        "player_warrior_kills=ShipStatistic(Player(),5);",
                        "player_ranger_kills=ShipStatistic(Player(),6);",
                        "if(CurrentMods('Evolution\\\\EvoFemRangers')) {",
                        "if(CurrentMods('Expansion\\\\ExpPilotBridge')) {",
                        "//EvoFemRangers + ExpPilotBridge: убийства по статистике мостика",
                        "player_ranger_kills=GRangStat+2*(GRangSpecStat+G_MCStat+G_RCStat+G_SBStat);",
                        "player_warrior_kills=GWarMilitStat+GWarPrivStat+2*(GWarFlagStat+GWarDreadStat+G_MBStat+G_IngBStat);",
                        "player_transport_kills=GCoalTranStat+GCoalLinStat+GCoalDipStat;",
                        "player_pirate_kills=GPirFreeStat+GPirClanStat+GPirRebStat+GRangPirStat+GPirThugStat+GPirKhanStat+GPirCorvStat+2*(GPirFrigStat+GPirGallStat+G_PBStat+G_PCBStat)+GPirSmugStat/2;",
                        "}",
                        "}"
                    ]
                },
