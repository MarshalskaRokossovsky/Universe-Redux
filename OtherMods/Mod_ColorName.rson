                    "Code": 
                    [
                        "temp_str2=ShipName(ShipPartners(Player(),tint1));",
                        "temp_str=TextBox(\"Введите новое имя вашего напарника\");",
                        "if(DeleteTags(temp_str2) != temp_str2)",
                        "{",
                        "    SetName(ShipPartners(Player(),tint1),substr(temp_str2,0,findsubstr(temp_str2,'>')+1)+temp_str+'</color>');",
                        "}",
                        "else",
                        "{",
                        "    SetName(ShipPartners(Player(),tint1),temp_str);",
                        "}",
                        "ShipMoney(ShipPartners(Player(),tint1),ShipMoney(ShipPartners(Player(),tint1))+5550);",
                        "ShipMoney(Player(),ShipMoney(Player())-5500);",
                        "Sound('Sound.Buy');"
