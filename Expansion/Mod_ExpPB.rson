      "if(sel == 10) { n0 = 1200; n0 = n0 - int(1.0 * 1200 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 1; }",
      "if(sel == 11) { n0 = 900; n0 = n0 - int(1.0 * 900 * n1 / 100.0 + 0.5); if(n0 < 100) n0 = 100; n2 = 1; }",
      "if(GetNodesFromShip(Player()) + RangerBaseNodes(Player()) >= n0)",
