      "InjectAnswer('PB_Chameleon_Do', '</color>' + Format(CT('FormRuins.PB.Chameleon.PlayerOk'), '<Series'+'>', 'Келлер', '<Cost'+'>', int(1.2 * fbf * (0.1 * PlayerChameleonCharges(0) + 1))), 0);",
      "InjectAnswer('PB_Chameleon_Do', '</color>' + Format(CT('FormRuins.PB.Chameleon.PlayerOk'), '<Series'+'>', 'Террон', '<Cost'+'>', int(1.1 * fbf * (0.1 * PlayerChameleonCharges(1) + 1))), 1);",
      "InjectAnswer('PB_Chameleon_Do', '</color>' + Format(CT('FormRuins.PB.Chameleon.PlayerOk'), '<Series'+'>', 'Блазер', '<Cost'+'>', int(1.3 * fbf * (0.1 * PlayerChameleonCharges(2) + 1))), 2);",
      "InjectAnswer('PB_Chameleon_No', '</color>' + CT('FormRuins.PB.Chameleon.PlayerNo'), 99);"
     ]
    },
    {
