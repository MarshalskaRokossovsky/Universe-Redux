            "Operations": 
            [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -600,
                    "Pos.y": 0,
                    "Parent": -1,
                    "#": 43,
                    "Code.Type": "Init",
                    "Code": 
                    [
                        "//vState: 0 - ещё не говорили, 1 - отказ, 2 - задание взято, 3 - выполнено, 4 - провал (ждём исхода), 5 - исход идёт",
                        "//Варианты квеста: Talk.SR1Epidemy.N (см. Lang), общие строки: Talk.SR1Epidemy.Common",
                        "",
                        "function EpiKey(key) {",
                        "    result = CT(path + QuestNum + '.' + key);",
                        "}",
                        "",
                        "function EpiText(key) {",
                        "    result = Format(CT(path + QuestNum + '.' + key), '<Plan1' + '>', Name(IdToPlanet(PlanId1)), '<Star1' + '>', Name(GalaxyStar(StarId1 - 1)), '<Plan2' + '>', Name(IdToPlanet(PlanId2)), '<Star2' + '>', Name(GalaxyStar(StarId2 - 1)), '<Ship' + '>', vShipName, '<Ranger' + '>', Name(Player()), '<Money' + '>', GalaxyMoney(2), '<Days' + '>', vMaxDay, '<Date' + '>', GameDateTxtByTurn(vEnd), '<Amount' + '>', vAmount);",
                        "}",
                        "",
                        "function EpiDlg(key) {",
                        "    result = '</color>' + EpiText(key);",
                        "}",
                        "",
                        "function EpiDlgOr(key, key2) {",
                        "    str k0 = key;",
                        "    if(EpiKey(key) == '') k0 = key2;",
                        "    result = EpiDlg(k0);",
                        "}",
                        "",
                        "function EpiCommon(key) {",
                        "    result = '</color>' + CT(path + 'Common.' + key);",
                        "}",
                        "",
                        "function EpiInList(lst, s) {",
                        "    int f = 0;",
                        "    for(int k6 = ParsCountFromString(lst, ',') - 1; k6 >= 0; k6 = k6 - 1) {",
                        "        if(GetParFromString(lst, ',', k6, 2) == s) f = 1;",
                        "    }",
                        "    result = f;",
                        "}",
                        "",
                        "function EpiRaceName(r) {",
                        "    str rn = '';",
                        "    if(r == Maloc) rn = 'Maloc';",
                        "    if(r == Peleng) rn = 'Peleng';",
                        "    if(r == People) rn = 'People';",
                        "    if(r == Fei) rn = 'Fei';",
                        "    if(r == Gaal) rn = 'Gaal';",
                        "    result = rn;",
                        "}",
                        "",
                        "//Фильтр FindPlanet: планеты только указанной расы",
                        "function EpiRaceFilter(rn) {",
                        "    str flt = 'NotKling,NotPirateClan,NotNone';",
                        "    if(rn != 'Maloc') flt = flt + ',NotMaloc';",
                        "    if(rn != 'Peleng') flt = flt + ',NotPeleng';",
                        "    if(rn != 'People') flt = flt + ',NotPeople';",
                        "    if(rn != 'Fei') flt = flt + ',NotFei';",
                        "    if(rn != 'Gaal') flt = flt + ',NotGaal';",
                        "    result = flt;",
                        "}",
                        "",
                        "//Система 20-45 пк от игрока с планетой, где продаётся нужный товар",
                        "function EpiFindStar2() {",
                        "    int ok = 0;",
                        "    int d2 = 0;",
                        "    dword st1 = GalaxyStar(StarId1 - 1);",
                        "    dword s2 = 0;",
                        "    dword p2 = 0;",
                        "    for(int k1 = 1; k1 < GalaxyStars(); k1 = k1 + 1) {",
                        "        s2 = StarNearbyStars(st1, k1);",
                        "        d2 = round(sqrt(Dist2Star(s2, st1)));",
                        "        if(d2 > 45) break;",
                        "        if(d2 < 20) continue;",
                        "        p2 = FindPlanet(s2, EpiKey('PlanetToRace'));",
                        "        if(p2) {",
                        "            StarId2 = Id(s2);",
                        "            PlanId2 = Id(p2);",
                        "            ok = 1;",
                        "            break;",
                        "        }",
                        "    }",
                        "    result = ok;",
                        "}",
                        "",
                        "//Подходящий свободный корабль в системе игрока",
                        "function EpiFindShip() {",
                        "    dword st1 = GalaxyStar(StarId1 - 1);",
                        "    dword r = 0;",
                        "    dword s1 = 0;",
                        "    dword p1 = 0;",
                        "    str rn = '';",
                        "    for(int k2 = StarShips(st1) - 1; k2 >= 0; k2 = k2 - 1) {",
                        "        s1 = StarShips(st1, k2);",
                        "        if(s1 == Player()) continue;",
                        "        if(!EpiInList(EpiKey('ShipType'), ShipType(s1))) continue;",
                        "        rn = EpiRaceName(ShipOwner(s1));",
                        "        if(!EpiInList(EpiKey('ShipRace'), rn)) continue;",
                        "        if(!ShipInNormalSpace(s1)) continue;",
                        "        if(ShipInScript(s1)) continue;",
                        "        if(ShipType(s1) == 'Warrior') {",
                        "            if(ShipInGameEvent(s1)) continue;",
                        "        }",
                        "        p1 = FindPlanet(st1, EpiRaceFilter(rn));",
                        "        if(!p1) continue;",
                        "        r = s1;",
                        "        PlanId1 = Id(p1);",
                        "        break;",
                        "    }",
                        "    result = r;",
                        "}",
                        "",
                        "function EpiSpawn(tp, p) {",
                        "    dword r = 0;",
                        "    if(tp == 'Ranger') r = BuyRanger(p);",
                        "    if(tp == 'Pirate') r = BuyPirate(p);",
                        "    if(tp == 'Warrior') r = BuyWarrior(p);",
                        "    if(tp == 'Transport') r = BuyTransport(p, 0);",
                        "    if(tp == 'Liner') r = BuyTransport(p, 1);",
                        "    if(tp == 'Diplomat') r = BuyTransport(p, 2);",
                        "    result = r;",
                        "}",
                        "",
                        "//Корабль не нашёлся - создаём на планете нужной расы в системе игрока",
                        "function EpiSpawnShip() {",
                        "    dword st1 = GalaxyStar(StarId1 - 1);",
                        "    str races = EpiKey('ShipRace');",
                        "    str types = EpiKey('ShipType');",
                        "    int rc = ParsCountFromString(races, ',');",
                        "    int r0 = Rnd(0, max(rc - 1, 0));",
                        "    int ri = 0;",
                        "    dword p1 = 0;",
                        "    dword r = 0;",
                        "    for(int k3 = 0; k3 < rc; k3 = k3 + 1) {",
                        "        ri = r0 + k3;",
                        "        if(ri >= rc) ri = ri - rc;",
                        "        p1 = FindPlanet(st1, EpiRaceFilter(GetParFromString(races, ',', ri, 2)));",
                        "        if(p1) break;",
                        "    }",
                        "    if(p1) {",
                        "        r = EpiSpawn(GetParFromString(types, ',', Rnd(0, max(ParsCountFromString(types, ',') - 1, 0)), 2), p1);",
                        "        PlanId1 = Id(p1);",
                        "    }",
                        "    result = r;",
                        "}",
                        "",
                        "//Выбор варианта: перебор с случайного, первый с выполненными условиями",
                        "function EpiSelect() {",
                        "    int cnt = int(CT(path + 'Count'));",
                        "    int first = Rnd(1, max(cnt, 1));",
                        "    int n = 0;",
                        "    dword st1 = GalaxyStar(StarId1 - 1);",
                        "    dword s = 0;",
                        "    for(int k4 = 0; k4 < cnt; k4 = k4 + 1) {",
                        "        n = first + k4;",
                        "        if(n > cnt) n = n - cnt;",
                        "        QuestNum = n;",
                        "        if(!EpiFindStar2()) continue;",
                        "        s = EpiFindShip();",
                        "        if(!s) s = EpiSpawnShip();",
                        "        if(s) break;",
                        "    }",
                        "    int ok = 0;",
                        "    if(s) {",
                        "        if(ShipInStar(s, st1)) {",
                        "            if(ShipInStar(Player(), st1)) ok = 1;",
                        "        }",
                        "    }",
                        "    if(!ok) {",
                        "        AllShipOut();",
                        "    }",
                        "    else {",
                        "        ShipJoin(ill, s);",
                        "        OrderLock(s, 1);",
                        "        NoTargetToShip(s, 3); //Запрет на ограбление для ИИ",
                        "        if(GetShipPlanet(s)) OrderTakeOff(s);",
                        "        vShipName = Name(s);",
                        "        vGoods = int(EpiKey('Goods'));",
                        "        vAmount = max(int(EpiKey('Amount')), 1);",
                        "        vMaxDay = int(EpiKey('Time'));",
                        "        vStep2 = 0;",
                        "        if(EpiKey('TextMainAskForHelp2') != '') vStep2 = 1;",
                        "        vAlt = 0;",
                        "        if(EpiKey('AltTypes') != '') vAlt = 1;",
                        "        vBegin = CurTurn();",
                        "        vJoined = 1;",
                        "        UpsurgeGoods(IdToPlanet(PlanId2), vGoods); //Распродажа нужного товара на планете назначения",
                        "    }",
                        "}",
                        "",
                        "function EpiRelease() {",
                        "    dword s = GroupToShip(ill);",
                        "    if(s) {",
                        "        OrderLock(s, 0);",
                        "        NoTargetToShip(s, 0);",
                        "    }",
                        "    SR1Epidemy_Last = CurTurn();",
                        "    AllShipOut();",
                        "}",
                        "",
                        "//Учёт покупок нужного товара на нужной планете (inc = учитывать и сегодняшний день)",
                        "function EpiScanBuys(inc) {",
                        "    int today = CurTurn();",
                        "    int dd = 0;",
                        "    if(vState == 2) {",
                        "        for(int k5 = GalaxyEvents() - 1; k5 >= 0; k5 = k5 - 1) {",
                        "            dd = GalaxyEventDate(k5);",
                        "            if(dd < vScanFrom) break;",
                        "            if(dd >= today && !inc) continue;",
                        "            if(GalaxyEventType(k5) == 'PlayerBuysGoodsFromPlanet') {",
                        "                if(GalaxyEventData(k5, 0) == vGoods && GalaxyEventData(k5, 3) == PlanId2) vBought = vBought + GalaxyEventData(k5, 1);",
                        "            }",
                        "        }",
                        "        if(inc) vScanFrom = today + 1;",
                        "        else vScanFrom = today;",
                        "    }",
                        "}",
                        "",
                        "//Предмет для альтернативного способа помощи (оборудование - только не установленное)",
                        "function EpiFindAlt() {",
                        "    dword r = 0;",
                        "    dword it = 0;",
                        "    str lst = EpiKey('AltTypes');",
                        "    vAltArt = 0;",
                        "    if(lst != '') {",
                        "        for(int k7 = ShipItems(Player()) - 1; k7 > 0; k7 = k7 - 1) {",
                        "            it = ShipItems(Player(), k7);",
                        "            if(ItemIsInUse(it)) continue;",
                        "            if(ItemIsInSet(it)) continue;",
                        "            if(ItemInScript(it) == 1) continue;",
                        "            if(EpiInList(lst, '' + ItemType(it))) r = it;",
                        "        }",
                        "        if(!r) {",
                        "            for(int k8 = ShipArts(Player()) - 1; k8 >= 0; k8 = k8 - 1) {",
                        "                it = ShipArts(Player(), k8);",
                        "                if(ItemInScript(it) == 1) continue;",
                        "                if(EpiInList(lst, '' + ItemType(it))) {",
                        "                    r = it;",
                        "                    vAltArt = 1;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "    result = r;",
                        "}",
                        "",
                        "function EpiTakeAlt() {",
                        "    dword it = EpiFindAlt();",
                        "    if(it) {",
                        "        if(vAltArt) {",
                        "            if(ItemIsInUse(it, Player())) ItemIsInUse(it, Player(), 0);",
                        "            FreeItem(GetArtFromShip(Player(), it));",
                        "        }",
                        "        else FreeItem(GetItemFromShip(Player(), it));",
                        "    }",
                        "}",
                        "",
                        "//Тексты ответов для сообщения m",
                        "function EpiAns(m) {",
                        "    vHasItem = 0;",
                        "    if(vAlt) {",
                        "        if(EpiFindAlt()) vHasItem = 1;",
                        "    }",
                        "    ta3 = EpiDlg('TextAltAsk');",
                        "    ta4 = EpiCommon('Bye');",
                        "    ta5 = EpiDlg('TextAltGive');",
                        "    if(m == 0) {",
                        "        ta1 = EpiDlg('TextMainAgree1');",
                        "        ta2 = EpiDlg('TextMainRefuse');",
                        "    }",
                        "    if(m == 1) {",
                        "        if(vStep2) ta1 = EpiDlg('TextMainQ2');",
                        "        else {",
                        "            ta1 = EpiDlg('TextMainAgree2');",
                        "            ta2 = EpiDlgOr('TextMainRefuse2', 'TextMainRefuse');",
                        "        }",
                        "    }",
                        "    if(m == 2 || m == 3) {",
                        "        ta1 = EpiDlg('TextMainAgree2');",
                        "        ta2 = EpiDlgOr('TextMainRefuse2', 'TextMainRefuse');",
                        "    }",
                        "    if(m == 6) {",
                        "        ta1 = EpiDlg('TextRightItem1');",
                        "        if(vBought < vAmount) ta1 = EpiDlgOr('TextItemWrong1', 'TextRightItem1');",
                        "        ta2 = EpiDlg('TextRefuse');",
                        "    }",
                        "    if(m == 7) ta1 = EpiCommon('Next');",
                        "}",
                        "",
                        "//Итог передачи товара (vPending: 1 - товар с нужной планеты, 2 - нет)",
                        "function EpiResult() {",
                        "    dword s = GroupToShip(ill);",
                        "    if(vPending == 1) {",
                        "        ShipMoney(Player(), ShipMoney(Player()) + GalaxyMoney(2));",
                        "        Ether(4, 'E3394CE0-4B64-4300-AC59-484317DF4BD4', '', s);",
                        "        vState = 3;",
                        "        tmsg = EpiDlg('TextRight');",
                        "    }",
                        "    else {",
                        "        Ether(5, 'E3394CE0-4B64-4300-AC59-484317DF4BD4', '', s);",
                        "        vState = 4;",
                        "        vFateTurn = CurTurn() + int(EpiKey('WrongDelay'));",
                        "        tmsg = EpiDlg('TextWrong');",
                        "    }",
                        "}",
                        "",
                        "//Сообщение на панель при исходе (тип 0 - новость, иначе реплика корабля)",
                        "function EpiNews() {",
                        "    dword s = GroupToShip(ill);",
                        "    if(EpiKey(vNewsKey) != '') {",
                        "        if(EpiKey(vNewsKey + 'Type') == '0') Ether(0, '', EpiText(vNewsKey));",
                        "        else if(ShipInNormalSpace(s)) Ether(1, '', '<clr' + '>' + vShipName + '<clrEnd' + '>' + ' ' + EpiText(vNewsKey), s);",
                        "        else Ether(1, '', '<clr' + '>' + vShipName + '<clrEnd' + '>' + ' ' + EpiText(vNewsKey));",
                        "    }",
                        "}",
                        "",
                        "//Исход: Explode - взрыв, Leave - улетает из системы, Star - падает на звезду, Land - садится на планету и гибнет, Military - уничтожают военные",
                        "function EpiStartFate(kind, newsKey) {",
                        "    dword s = GroupToShip(ill);",
                        "    dword st1 = GalaxyStar(StarId1 - 1);",
                        "    str f = EpiKey(kind);",
                        "    str nk = newsKey;",
                        "    int cnt = 0;",
                        "    if(f == '') { //Нет отдельного исхода по времени - как при неверном товаре",
                        "        f = EpiKey('WrongFate');",
                        "        nk = 'NewsWrong';",
                        "    }",
                        "    vState = 5;",
                        "    vFateTurn = CurTurn();",
                        "    vNewsKey = nk;",
                        "    vFate = 1;",
                        "    if(f == 'Leave') vFate = 2;",
                        "    if(f == 'Star') vFate = 3;",
                        "    if(f == 'Land') vFate = 4;",
                        "    if(f == 'Military') vFate = 5;",
                        "    if(vFate != 4) EpiNews();",
                        "    NoTargetToShip(s, 0);",
                        "    if(vFate == 2) vFateStar = Id(StarNearbyStars(st1, 1));",
                        "    if(vFate == 5) {",
                        "        for(int k9 = StarShips(st1) - 1; k9 >= 0; k9 = k9 - 1) {",
                        "            if(StarShips(st1, k9) != s) {",
                        "                if(ShipType(StarShips(st1, k9)) == 'Warrior') cnt = cnt + 1;",
                        "            }",
                        "        }",
                        "        if(cnt < 2) {",
                        "            BuyWarrior(IdToPlanet(PlanId1));",
                        "            BuyWarrior(IdToPlanet(PlanId1));",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "function EpiFateTick() {",
                        "    dword s = GroupToShip(ill);",
                        "    dword st1 = GalaxyStar(StarId1 - 1);",
                        "    dword w = 0;",
                        "    if(vFate == 1) ShipDestroy(s);",
                        "    if(vFate == 2) {",
                        "        if(ShipInNormalSpace(s)) {",
                        "            if(ShipInStar(s, st1)) OrderJump(s, GalaxyStar(vFateStar - 1));",
                        "            else EpiRelease();",
                        "        }",
                        "    }",
                        "    if(vFate == 3) {",
                        "        if(ShipInNormalSpace(s)) OrderMove(s, 0, 0);",
                        "        if(DistCoords(CoordX(s), CoordY(s), 0, 0) < 150 || CurTurn() - vFateTurn > 20) ShipDestroy(s);",
                        "    }",
                        "    if(vFate == 4) {",
                        "        if(GetShipPlanet(s) || CurTurn() - vFateTurn > 20) {",
                        "            EpiNews();",
                        "            ShipDestroy(s);",
                        "        }",
                        "        else if(ShipInNormalSpace(s)) OrderLanding(s, IdToPlanet(PlanId1));",
                        "    }",
                        "    if(vFate == 5) {",
                        "        for(int k10 = StarShips(st1) - 1; k10 >= 0; k10 = k10 - 1) {",
                        "            w = StarShips(st1, k10);",
                        "            if(ShipType(w) == 'Warrior') {",
                        "                if(!ShipInScript(w, 0)) ShipSetBad(w, s);",
                        "            }",
                        "        }",
                        "        if(CurTurn() - vFateTurn > 10) ShipDestroy(s);",
                        "    }",
                        "}",
                        "",
                        "path = 'Talk.SR1Epidemy.';",
                        "StarId1 = Id(ShipStar(Player()));"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -600,
                    "Pos.y": 200,
                    "Parent": -1,
                    "#": 44,
                    "Code.Type": "Global",
                    "Code": 
                    [
                        "if(GRunFrom == 3) {",
                        "    if(!SR1Epidemy_Last) SR1Epidemy_Last = CurTurn(); //Первая пауза отсчитывается от начала игры",
                        "    if(CurTurn() - SR1Epidemy_Last > int(CT('Talk.SR1Epidemy.Cooldown'))) GRun();",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -600,
                    "Pos.y": 300,
                    "Parent": -1,
                    "#": 45,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "if(!vJoined) {",
                        "    EpiSelect();",
                        "    exit;",
                        "}",
                        "tship = GroupToShip(ill);",
                        "if(!tship) { //Корабль погиб или покинул скрипт",
                        "    if(vState == 2) Ether(5, 'E3394CE0-4B64-4300-AC59-484317DF4BD4', '', Player());",
                        "    EpiRelease();",
                        "    exit;",
                        "}",
                        "EpiScanBuys(0);",
                        "if(vState == 0) {",
                        "    if(CountTurn(Player(), tship) < 5) Ether(1, '', '<clr' + '>' + vShipName + '<clrEnd' + '>' + ' ' + EpiText('SendingEmail'), tship);",
                        "    if(CurTurn() - vBegin > 9) { //Игрок так и не откликнулся",
                        "        EpiRelease();",
                        "        exit;",
                        "    }",
                        "}",
                        "if(vState == 1) {",
                        "    if(CurTurn() - vBegin >= int(EpiKey('RefuseDelay'))) EpiStartFate('RefuseFate', 'NewsFailed');",
                        "}",
                        "if(vState == 2) {",
                        "    if(CurTurn() > vEnd) { //Время вышло",
                        "        Ether(5, 'E3394CE0-4B64-4300-AC59-484317DF4BD4', '', tship);",
                        "        EpiStartFate('TimeoutFate', 'NewsTimeout');",
                        "    }",
                        "}",
                        "if(vState == 3) {",
                        "    EpiRelease();",
                        "    exit;",
                        "}",
                        "if(vState == 4) {",
                        "    if(CurTurn() >= vFateTurn) EpiStartFate('WrongFate', 'NewsWrong');",
                        "}",
                        "if(vState == 5) {",
                        "    EpiFateTick();",
                        "    exit;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 760,
                    "Pos.y": -170,
                    "Parent": -1,
                    "#": 47,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "tship = GroupToShip(ill);",
                        "EpiScanBuys(1);",
                        "if(vState == 0) {",
                        "    tmsg = EpiDlg('TextMainAskForHelp');",
                        "    EpiAns(0);",
                        "    DChange(0);",
                        "    exit;",
                        "}",
                        "if(vState == 2) {",
                        "    if(GoodsCount(Player(), vGoods) >= vAmount) {",
                        "        if(Dist(tship, Player()) >= 500) {",
                        "            if(EpiKey('TextFlyNearer') != '') {",
                        "                tmsg = EpiDlg('TextFlyNearer');",
                        "                EpiAns(4);",
                        "                DChange(4);",
                        "                exit;",
                        "            }",
                        "        }",
                        "        tmsg = EpiDlgOr('TextMainA3', 'TextWeWait');",
                        "        EpiAns(6);",
                        "        DChange(6);",
                        "        exit;",
                        "    }",
                        "    tmsg = EpiDlg('TextWeWait');",
                        "    EpiAns(5);",
                        "    DChange(5);",
                        "    exit;",
                        "}",
                        "if(vState == 1) tmsg = EpiDlgOr('TextRefused', vRefuseKey);",
                        "else if(vState == 3) tmsg = EpiDlg('TextRight');",
                        "else tmsg = EpiDlgOr('TextDying', 'TextWrong');",
                        "EpiAns(4);",
                        "DChange(4);",
                        "exit;"
                    ]
                },
