            "Items": [
                {
                    "Type": "TItem",
                    "Name": "AncientCrystal",
                    "Pos.x": 420,
                    "Pos.y": 150,
                    "Parent": -1,
                    "#": 20,
                    "Class": 5,
                    "Item.Type": 0,
                    "Size": 10,
                    "Level": 1,
                    "Radius": 150,
                    "Owner": 6,
                    "Useless": "",
