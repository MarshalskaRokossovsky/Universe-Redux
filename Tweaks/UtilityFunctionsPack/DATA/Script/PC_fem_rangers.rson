                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 890,
                    "Pos.y": -350,
                    "Parent": -1,
                    "#": 8,
                    "Total.Lines": 58,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(CurrentMods('Evolution\\\\EvoFemRangers')) {",
                        "g_SpawnFemRanger(quest_planet);",
                        "} else {",
                        "quest_ship=BuyRanger(quest_planet);",
                        "bon=FindBonusByName(hull_names[GalaxyTechLevel()-1]);",
                        "if (bon>-1){SpecialToEquipment(bon,ShipItems(quest_ship,0));}",
                        "ShipRefit(quest_ship);",
                        "ShipRefit(quest_ship);",
                        "ShipRefit(quest_ship);",
                        "counter=0;",
                        "while (counter<ShipItems(quest_ship)){",
                        "quest_item=ShipItems(quest_ship,counter);",
                        "if (ItemType(quest_item)>=t_Weapon1){",
                        "if (ItemType(quest_item)<=t_Weapon12){",
                        "if (ItemType(quest_item)!=t_Weapon4){",
                        "FreeItem(GetItemFromShip(quest_ship,counter));",
                        "quest_item=CreateEquipment(t_Weapon4,10+Rnd(1,10),GalaxyTechLevel(),2);",
                        "AddItemToShip(quest_ship,quest_item);}}}",
                        "counter=counter+1;}",
                        "quest_item=CreateEquipment(t_Weapon4,10+Rnd(1,10),GalaxyTechLevel(),2);",
                        "AddItemToShip(quest_ship,quest_item);",
                        "ShipImproveItems(quest_ship,2*GalaxyTechLevel());",
                        "counter=Rnd(1,1000)%ArrayDim(fem_names);",
                        "name_used=1;",
                        "while (name_used){",
                        "counter=counter+1;",
                        "if (counter>=ArrayDim(fem_names)){counter=0;}",
                        "counter2=0;",
                        "name_used=0;",
                        "if (ShipName(Player())==fem_names[counter]){name_used=1;}",
                        "while ((counter2<GroupCount(GroupFem)) && !name_used){",
                        "if (ShipName(GroupShip(GroupFem,counter2))==fem_names[counter]){name_used=1;}",
                        "counter2=counter2+1;}}",
                        "SetName(quest_ship,fem_names[counter]);",
                        "counter=24+Rnd(1,1000)%8;",
                        "name_used=1;",
                        "while (name_used){",
                        "counter=counter+1;",
                        "if (counter>=33){counter=25;}",
                        "counter2=0;",
                        "name_used=0;",
                        "while ((counter2<GroupCount(GroupFem)) && !name_used){",
                        "if (ShipFace(GroupShip(GroupFem,counter2))==counter){name_used=1;}",
                        "counter2=counter2+1;}}",
                        "ShipFace(quest_ship,counter);",
                        "Chameleon(quest_ship);",
                        "ShipStatus(quest_ship,0,70+Id(quest_ship)%11);",
                        "ShipStatus(quest_ship,1,0);",
                        "ShipStatus(quest_ship,2,30-Id(quest_ship)%11);",
                        "ShipJoin(GroupFem,quest_ship);",
                        "counter=0;",
                        "while (IdToShip(fem_id[counter])){counter=counter+1;}",
                        "fem_id[counter]=Id(quest_ship);",
                        "quest_data1[counter]=0;",
                        "quest_data2[counter]=0;",
                        "trust_value[counter]=0;",
                        "cur_num=cur_num+1;",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 690,
                    "Pos.y": -230,
                    "Parent": -1,
                    "#": 13,
                    "Total.Lines": 212,
                    "Code.Type": "Init",
                    "Code": [
                        "//Универсальный PC_fem_rangers (UtilityFunctionsPack). Ветки для модов, которым он нужен:",
                        "//  Tweaks\\BlockPirates - скрипт отключается (AllShipOut), спецагенток нет",
                        "//  Tweaks\\FemsBugs - в уведомления выводится, что именно неверно в отчете о слежке за дипломатом",
                        "//    (тексты в Lang мода, ключи Script.PC_fem_rangers.FemsBugs*)",
                        "//  Tweaks\\RevolutionDelayed - спецагентки появляются только после начала пиратской войны (pirates_begin_turn мода)",
                        "//  Evolution\\EvoFemRangers - спецагентки мода (g_SpawnFemRanger): тип FemRanger, облик Ушастика в цветах людей,",
                        "//    имена из Lang мода, портреты 37-44 (SR1Faces) и 46-47 (мод), торговый подтип, появляются только в системах Коалиции;",
                        "//    коэффициенты отношений и пороги разговоров из Lang мода (SpecialAgentsRelations, SpecialAgentTalks);",
                        "//    с Expansion\\ExpPilotBridge - убийства по статистике мостика; с Reflection\\RefSpAgHybrid - гибридный дроид",
                        "//    с режимами через акткод RefSpAgHybrid. Малокши выключены (агентки только люди).",
                        "//Без этих модов логика ванильная.",
                        "if(CurrentMods('Tweaks\\\\BlockPirates')) AllShipOut();",
                        "bonus_mm=newarray(1);",
                        "fem_names=newarray(1);",
                        "fem_names[0]=CT('Script.PC_fem_rangers.18');",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.17'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.16'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.15'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.14'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.13'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.12'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.11'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.10'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.9'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.8'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.7'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.6'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.5'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.4'));",
                        "ArrayAdd(fem_names,CT('Script.PC_fem_rangers.3'));",
                        "//---------- Функции веток модов ----------",
                        "//RevolutionDelayed: спецагентки не появляются до начала пиратской войны",
                        "function FemSpawnAllowed()",
                        "{",
                        "    result = 1;",
                        "    if(CurrentMods('Tweaks\\\\RevolutionDelayed'))",
                        "    {",
                        "        if(GetValueFromScript('Mod_RevolutionDelayed', 'pirates_begin_turn') > CurTurn()) result = 0;",
                        "    }",
                        "}",
                        "",
                        "//Планета для новой спецагентки: ваниль - планета людей, EvoFemRangers - коренное население люди (малокши выключены)",
                        "function FemPlanetOk()",
                        "{",
                        "    result = 0;",
                        "    if(CurrentMods('Evolution\\\\EvoFemRangers'))",
                        "    {",
                        "        if(quest_planet)",
                        "        {",
                        "            if(PlanetRace(quest_planet) == People) result = 1;",
                        "        }",
                        "    }",
                        "    else",
                        "    {",
                        "        if(PlanetOwner(quest_planet) == 2) result = 1;",
                        "    }",
                        "}",
                        "",
                        "//Пороги разговоров: EvoFemRangers - из Lang мода (SpecialAgentTalks), иначе ванильные",
                        "function FemTalkValue(str key, int dflt)",
                        "{",
                        "    result = dflt;",
                        "    if(CurrentMods('Evolution\\\\EvoFemRangers')) result = int(CT('Script.PC_fem_rangers.SpecialAgentTalks.' + key));",
                        "}",
                        "",
                        "//EvoFemRangers: для внешних запросов",
                        "function g_GetFemRangers(int num = -1)",
                        "{",
                        "    if(~num) result = GroupShip(GroupFem, num);",
                        "    else result = GroupCount(GroupFem);",
                        "}",
                        "",
                        "function g_CreateHybridDroid()",
                        "{",
                        "    quest_item = CreateEquipment(t_RepairRobot, 20, 8, 2);",
                        "    bon = FindBonusByCustomTag('A1D1M1');",
                        "    if(bon > -1) SpecialToEquipment(bon, quest_item);",
                        "    LinkItemToScript(quest_item, HybridDroid);",
                        "",
                        "    result = quest_item;",
                        "}",
                        "",
                        "//Бесповоротно фейлит квест с нормальным получением гибридного дроида",
                        "function g_FailHybridDroidAcception()",
                        "{",
                        "    player_hate = 1;",
                        "    quest_status = 4;",
                        "}",
                        "",
                        "//EvoFemRangers: новая спецагентка (будет добавлена в скрипт по всем правилам). Малокши выключены - только люди.",
                        "function g_SpawnFemRanger(dword planet = 0)",
                        "{",
                        "    dword f_ship;",
                        "    dword f_item;",
                        "    int f_bon;",
                        "    int f_n;",
                        "    int f_cnt;",
                        "    int f_k;",
                        "    int f_used;",
                        "    int f_pool;",
                        "    str f_cfg;",
                        "    str f_name;",
                        "",
                        "    result = 0;",
                        "    if(!planet) planet = NearCivilPlanet(Player());",
                        "    if(planet)",
                        "    {",
                        "        f_ship = BuyRanger(planet);",
                        "        ShipType(f_ship, 'FemRanger');",
                        "",
                        "        //Корпус Ушастик I-IV по уровню техники (разделы 480-483 в Lang), при неудаче - ванильный выбор",
                        "        f_cfg = '483';",
                        "        if(GalaxyTechLevel() <= 6) f_cfg = '482';",
                        "        if(GalaxyTechLevel() <= 4) f_cfg = '481';",
                        "        if(GalaxyTechLevel() <= 2) f_cfg = '480';",
                        "        f_bon = FindBonusByNameInCfg(f_cfg);",
                        "        if(f_bon < 0) f_bon = FindBonusByName(hull_names[GalaxyTechLevel() - 1]);",
                        "        if(f_bon > -1) SpecialToEquipment(f_bon, ShipItems(f_ship, 0));",
                        "",
                        "        ShipRefit(f_ship);",
                        "        ShipRefit(f_ship);",
                        "        ShipRefit(f_ship);",
                        "",
                        "        Chameleon(f_ship, 'Ship.AkrinFemale.SecretAgentPeople');",
                        "",
                        "        f_k = 0;",
                        "        while(f_k < ShipItems(f_ship))",
                        "        {",
                        "            f_item = ShipItems(f_ship, f_k);",
                        "            if(ItemType(f_item) >= t_Weapon1)",
                        "            {",
                        "                if(ItemType(f_item) <= t_Weapon12)",
                        "                {",
                        "                    if(ItemType(f_item) != t_Weapon4)",
                        "                    {",
                        "                        FreeItem(GetItemFromShip(f_ship, f_k));",
                        "                        f_item = CreateEquipment(t_Weapon4, 10 + RndObject(1, 10, f_ship), GalaxyTechLevel(), 2);",
                        "                        AddItemToShip(f_ship, f_item);",
                        "                    }",
                        "                }",
                        "            }",
                        "            f_k = f_k + 1;",
                        "        }",
                        "",
                        "        f_item = CreateEquipment(t_Weapon4, 10 + RndObject(1, 10, f_ship), GalaxyTechLevel(), 2);",
                        "        AddItemToShip(f_ship, f_item);",
                        "        ShipImproveItems(f_ship, 2 * GalaxyTechLevel());",
                        "",
                        "        //Имя из Lang мода, не занятое игроком и живыми спецагентками",
                        "        f_cnt = int(CT('Script.PC_fem_rangers.SecretAgentNames.People.Count'));",
                        "        f_n = RndObject(1, 1000, f_ship) % f_cnt;",
                        "        f_used = 1;",
                        "        while(f_used)",
                        "        {",
                        "            f_n = f_n + 1;",
                        "            if(f_n >= f_cnt) f_n = 0;",
                        "            f_name = CT('Script.PC_fem_rangers.SecretAgentNames.People.' + (f_n + 1));",
                        "",
                        "            f_used = 0;",
                        "            if(ShipName(Player()) == f_name) f_used = 1;",
                        "            f_k = 0;",
                        "            while(f_k < GroupCount(GroupFem) && !f_used)",
                        "            {",
                        "                if(ShipName(GroupShip(GroupFem, f_k)) == f_name) f_used = 1;",
                        "                f_k = f_k + 1;",
                        "            }",
                        "        }",
                        "        SetName(f_ship, f_name);",
                        "",
                        "        //Портрет: 37-44 (SR1Faces, зависимость мода) и 46-47 (мод); 45 нет ни в одном моде - пропускается",
                        "        f_n = 36 + RndObject(1, 1000, f_ship) % 8;",
                        "        f_pool = 10;",
                        "        f_used = 1;",
                        "        while(f_used && f_pool)",
                        "        {",
                        "            f_n = f_n + 1;",
                        "            if(f_n == 45) f_n = 46;",
                        "            if(f_n > 47) f_n = 37;",
                        "",
                        "            f_used = 0;",
                        "            f_k = 0;",
                        "            while(f_k < GroupCount(GroupFem) && !f_used)",
                        "            {",
                        "                if(ShipPilotRace(GroupShip(GroupFem, f_k)) == People)",
                        "                {",
                        "                    if(ShipFace(GroupShip(GroupFem, f_k)) == f_n) f_used = 1;",
                        "                }",
                        "                f_k = f_k + 1;",
                        "            }",
                        "            //Чтобы не зациклилось, если агенток больше, чем портретов",
                        "            f_pool = f_pool - 1;",
                        "        }",
                        "        ShipFace(f_ship, f_n);",
                        "",
                        "        //Упор в торговое поведение, чтобы реже гибли в боях за системы",
                        "        ShipStatus(f_ship, 0, 70 + Id(f_ship) % 11);",
                        "        ShipStatus(f_ship, 1, 0);",
                        "        ShipStatus(f_ship, 2, 30 - Id(f_ship) % 11);",
                        "        ShipSubType(f_ship, 0); //Торговец",
                        "",
                        "        ShipJoin(GroupFem, f_ship);",
                        "",
                        "        counter = 0;",
                        "        while(IdToShip(fem_id[counter])) counter = counter + 1;",
                        "        fem_id[counter] = Id(f_ship);",
                        "        quest_data1[counter] = 0;",
                        "        quest_data2[counter] = 0;",
                        "        trust_value[counter] = 0;",
                        "        cur_num = cur_num + 1;",
                        "        result = f_ship;",
                        "    }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 790,
                    "Pos.y": 840,
                    "Parent": -1,
                    "#": 14,
                    "Total.Lines": 6,
                    "Code.Type": "Turn",
                    "Code": [
                        "//BuildListOfMMByPriority(bonus_mm,100-5*GalaxyTechLevel(),80-10*GalaxyTechLevel());",
                        "//ArrayRandomize(50,bonus_mm);",
                        "//counter=0;",
                        "//while (counter<(GalaxyTechLevel()-1)){",
                        "//AddItemToShip(CurShip,CreateMM(bonus_mm[counter]));",
                        "//counter=counter+1;}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 830,
                    "Pos.y": 1000,
                    "Parent": -1,
                    "#": 23,
                    "Total.Lines": 30,
                    "Code.Type": "Turn",
                    "Code": [
                        "ShipStatus(CurShip,0,70+Id(CurShip)%11);",
                        "ShipStatus(CurShip,1,0);",
                        "ShipStatus(CurShip,2,30-Id(CurShip)%11);",
                        "RelationToRanger(PlanetPirateClan(),CurShip,100-pirate_side_chosen*50);",
                        "if (pirate_side_chosen==2){",
                        "if (GetShipPlanet(CurShip)){",
                        "if (PlanetOwner(GetShipPlanet(CurShip))==7){",
                        "OrderNone(CurShip);",
                        "OrderLock(CurShip,1);",
                        "ShipDestroy(CurShip);",
                        "}}}",
                        "quest_star=ShipStar(CurShip);",
                        "counter=0;",
                        "while (counter<StarPlanets(quest_star)){",
                        "quest_planet=StarPlanets(quest_star,counter);",
                        "if (PlanetOwner(quest_planet)<5){",
                        "RelationToRanger(quest_planet,CurShip,100);}",
                        "counter=counter+1;}",
                        "counter=0;",
                        "while (counter<StarShips(quest_star)){",
                        "quest_ship=StarShips(quest_star,counter);",
                        "if (ShipOwner(quest_ship)<5){",
                        "if (ShipTypeN(quest_ship)<4){",
                        "if (RelationToRanger(quest_ship,CurShip)>=10){",
                        "if (ShipGetBad(quest_ship)!=CurShip){",
                        "RelationToRanger(quest_ship,CurShip,100);}}}}",
                        "counter=counter+1;}",
                        "if (ShipStar(Player())!=ShipStar(CurShip)){",
                        "HullHP(CurShip,min(HullHP(CurShip)+5,ItemSize(ShipItems(CurShip,0))));}",
                        "quest_ship=ShipGetBad(CurShip);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 890,
                    "Pos.y": -510,
                    "Parent": -1,
                    "#": 26,
                    "Total.Lines": 16,
                    "Code.Type": "Turn",
                    "Code": [
                        "quest_planet=0;",
                        "counter=0;",
                        "if(CurrentMods('Evolution\\\\EvoFemRangers')) {",
                        "//EvoFemRangers: только системы Коалиции",
                        "while (!quest_planet && (counter<5)){",
                        "quest_star=GalaxyStar(Rnd(1,1000)%GalaxyStars());",
                        "quest_planet=StarPlanets(quest_star,RndObject(1,1000,quest_star)%StarPlanets(quest_star));",
                        "if (StarOwner(quest_star)){quest_planet=0;}",
                        "counter=counter+1;}",
                        "} else {",
                        "while (!quest_planet && (counter<5)){",
                        "quest_star=GalaxyStar(Rnd(1,1000)%GalaxyStars());",
                        "quest_planet=StarPlanets(quest_star,Rnd(1,1000)%StarPlanets(quest_star));",
                        "counter=counter+1;}",
                        "}",
                        "//quest_planet=StarPlanets(GalaxyStar(2),2);//"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 920,
                    "Pos.y": 960,
                    "Parent": -1,
                    "#": 33,
                    "Total.Lines": 1,
                    "Code.Type": "Turn",
                    "Code": [
                        "quest_planet=GetShipPlanet(CurShip);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 690,
                    "Pos.y": -140,
                    "Parent": -1,
                    "#": 39,
                    "Total.Lines": 15,
                    "Code.Type": "Init",
                    "Code": [
                        "max_num=5;",
                        "fem_id=newarray(max_num);",
                        "quest_data1=newarray(max_num);",
                        "quest_data2=newarray(max_num);",
                        "trust_value=newarray(max_num);",
                        "counter=0;",
                        "while (counter<max_num){",
                        "fem_id[counter]=0;",
                        "quest_data1[counter]=0;",
                        "quest_data2[counter]=0;",
                        "trust_value[counter]=0;",
                        "counter=counter+1;}",
                        "enemy_id=newarray(1);",
                        "new_enemies=newarray(1);",
                        "locations=newarray(1);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 930,
                    "Pos.y": -470,
                    "Parent": -1,
                    "#": 42,
                    "Total.Lines": 2,
                    "Code.Type": "Turn",
                    "Code": [
                        "counter=0;",
                        "while (fem_id[counter] && IdToShip(fem_id[counter])){counter=counter+1;}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 930,
                    "Pos.y": -430,
                    "Parent": -1,
                    "#": 43,
                    "Total.Lines": 21,
                    "Code.Type": "Turn",
                    "Code": [
                        "counter2=GalaxyEvents()-1;",
                        "while (counter2>=0){",
                        "if (GalaxyEventDate(counter2)>=CurTurn()){",
                        "if (GalaxyEventType(counter2)=='PlayerKillsShip'){",
                        "if (GalaxyEventData(counter2,2)==fem_id[counter]){",
                        "player_hate=1;}}",
                        "if (GalaxyEventType(counter2)=='PlayerAssistKillsShip'){",
                        "if (GalaxyEventData(counter2,2)==fem_id[counter]){",
                        "player_hate=1;}}",
                        "if (GalaxyEventType(counter2)=='PlayerCompanionKillsShip'){",
                        "if ((GalaxyEventData(counter2,2)==fem_id[counter]) && (GalaxyEventData(counter2,2)==Id(ShipStar(Player())))){",
                        "player_hate=1;}}",
                        "if (GalaxyEventType(counter2)=='PlayerCompanionAssistKillsShip'){",
                        "if ((GalaxyEventData(counter2,2)==fem_id[counter]) && (GalaxyEventData(counter2,2)==Id(ShipStar(Player())))){",
                        "player_hate=1;}}",
                        "if (GalaxyEventType(counter2)=='PlayerTranclucatorKillsShip'){",
                        "if ((GalaxyEventData(counter2,2)==fem_id[counter]) && (GalaxyEventData(counter2,2)==Id(ShipStar(Player())))){",
                        "player_hate=1;}}",
                        "}",
                        "if (GalaxyEventDate(counter2)<CurTurn()){counter2=0;}",
                        "counter2=counter2-1;}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 930,
                    "Pos.y": -390,
                    "Parent": -1,
                    "#": 45,
                    "Total.Lines": 4,
                    "Code.Type": "Turn",
                    "Code": [
                        "fem_id[counter]=0;",
                        "quest_data1[counter]=0;",
                        "quest_data2[counter]=0;",
                        "cur_num=cur_num-1;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1220,
                    "Pos.y": 960,
                    "Parent": -1,
                    "#": 47,
                    "Total.Lines": 16,
                    "Code.Type": "Turn",
                    "Code": [
                        "quest_ship=0;",
                        "ship_to_guard=0;",
                        "counter=0;",
                        "while (counter<StarShips(quest_star)){",
                        "quest_ship=StarShips(quest_star,counter);",
                        "if ((GetShipPlanet(quest_ship)==quest_planet) || (ShipInNormalSpace(quest_ship) && (Dist(quest_ship,CurShip)<500) && (HullDamage(quest_ship)<25))){",
                        "if (ShipTypeN(quest_ship)==t_Transport){",
                        "if (ShipGetBad(quest_ship)!=CurShip){",
                        "if (!ShipInScript(quest_ship)){",
                        "if (ShipSpeed(CurShip)>(150+ShipSpeed(quest_ship))){",
                        "ship_to_guard=quest_ship;}}}}}",
                        "counter=counter+1;}",
                        "if (!ship_to_guard){",
                        "if (!Rnd(0,20)){",
                        "ship_to_guard=BuyTransport(quest_planet);",
                        "}}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1080,
                    "Pos.y": 960,
                    "Parent": -1,
                    "#": 53,
                    "Total.Lines": 1,
                    "Code.Type": "Turn",
                    "Code": [
                        "quest_star=ShipStar(CurShip);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 59,
                    "Total.Lines": 5,
                    "Code.Type": "Turn",
                    "Code": [
                        "counter=0;",
                        "ship_under_prot=0;",
                        "while (counter<max_num){",
                        "if (quest_data1[counter]==Id(CurShip)){ship_under_prot=1;}",
                        "counter=counter+1;}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 260,
                    "Pos.y": 600,
                    "Parent": -1,
                    "#": 62,
                    "Total.Lines": 2,
                    "Code.Type": "Turn",
                    "Code": [
                        "OrderLock(CurShip,0);",
                        "ShipOut(CurShip)"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1170,
                    "Pos.y": 880,
                    "Parent": -1,
                    "#": 63,
                    "Total.Lines": 4,
                    "Code.Type": "Turn",
                    "Code": [
                        "ShipRefuel(ship_to_guard);",
                        "ShipRepairEq(ship_to_guard);",
                        "quest_data1[ship_num]=Id(ship_to_guard);",
                        "quest_data2[ship_num]=CurTurn()+100;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1170,
                    "Pos.y": 960,
                    "Parent": -1,
                    "#": 64,
                    "Total.Lines": 3,
                    "Code.Type": "Turn",
                    "Code": [
                        "counter=0;",
                        "while (fem_id[counter]!=Id(CurShip)){counter=counter+1;}",
                        "ship_num=counter;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 1170,
                    "Pos.y": 840,
                    "Parent": -1,
                    "#": 67,
                    "Total.Lines": 8,
                    "Code.Type": "Turn",
                    "Code": [
                        "ShipRefuel(CurShip);",
                        "ShipRepairEq(CurShip);",
                        "OrderNone(CurShip);",
                        "OrderLock(CurShip,1);",
                        "temp_curship=CurShip;",
                        "ShipJoin(GroupTransports,ship_to_guard);",
                        "ChangeState(6,temp_curship);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 750,
                    "Pos.y": 1080,
                    "Parent": -1,
                    "#": 68,
                    "Total.Lines": 5,
                    "Code.Type": "Turn",
                    "Code": [
                        "ship_to_guard=0;",
                        "counter=0;",
                        "while (counter<GroupCount(GroupTransports)){",
