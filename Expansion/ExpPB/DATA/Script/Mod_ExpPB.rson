    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 0,
     "Pos.y": 260,
     "Parent": -1,
     "#": 136,
     "Code.Type": "DialogBegin",
     "Code": [
      "cur_ruin = GetShipRuins(Player());",
      "//if(cur_ruin) SFT(\"ExpPB DialogBegin: base type=\" + ShipType(cur_ruin));",
      "if(cur_ruin)",
      "{",
      "    if(ShipType(cur_ruin) == 'PB')",
      "    {",
      "        t0 = '';",
      "        //--- ChangeSide: в коалицию - пока Коалиция не разгромлена; в клан - пока клан не побеждён (PirateWin 3), впервые (без ShipInPirateClan) - только после вступительного PC_part0 ---",
      "        AddDialogBlock(CT('FormRuins.PB.ChangeSide.ChangeSideToPirate'), 2);",
      "        AddDialogBlock(CT('FormRuins.PB.ChangeSide.ChangeSideToNormal'), 2);",
      "        if(ShipOnSidePirateClan(Player()) && !CoalitionDefeated()) AddDialogInject('PB_ChangeSide', '', DeleteTags(t0 + \"Я хочу получить обратно рейнджерское звание\"), 1);",
      "        if(!ShipOnSidePirateClan(Player()) && PirateWin() != 3 && (ShipInPirateClan(Player()) || IsScriptActive('PC_part0') == 0)) AddDialogInject('PB_ChangeSide', '', DeleteTags(t0 + \"Я хочу перейти на сторону пиратского клана\"), 1);",
      "        //--- ChangeNationality: сверху только без ExpImplants; иначе уезжает в подменю PB_BodyMods ---",
      "        AddDialogBlock(CT('FormRuins.PB.ChangeNationality.ChangeNationality'), 2);",
      "        if(!CurrentMods('Expansion\\\\ExpImplants')) AddDialogInject('PB_ChangeNationality', '', DeleteTags(t0 + \"Меня интересует смена подданства\"), 1);",
      "        //--- Program: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
      "        AddDialogBlock(CT('FormRuins.PB.Program.PlayerAsk'), 2);",
      "        //--- Nod: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
      "        AddDialogBlock(CT('FormRuins.PB.Nod.PlayerAsk'), 2);",
      "        //--- Repair ---",
      "        AddDialogBlock(CT('FormRuins.PB.Repair.PlayerSend'), 2);",
      "        AddDialogInject('PB_Repair', '', DeleteTags(t0 + \"Мне нужно починить оборудование\"), 1);",
      "        //--- Chameleon: блокируем ванильный ответ, инжект уезжает в подменю PB_Shop ---",
      "        AddDialogBlock(CT('FormRuins.PB.Chameleon.PlayerAsk'), 2);",
      "        //--- Группирующие подменю (сообщение НЕ трогаем -> остаётся приветствие ПБ) ---",
      "        AddDialogInject('PB_Shop', '', '</color>' + CT('FormRuins.PB.Grouping.Shop'), 1);",
      "        if(CurrentMods('Expansion\\\\ExpImplants')) AddDialogInject('PB_BodyMods', '', '</color>' + CT('FormRuins.PB.Grouping.BodyMods'), 1);",
      "        //--- SabCrack (сабмодем): ванильный гейт TPlayer.MayTakeSubCrack = билдин PlayerMayTakeSubCrack():",
      "        //    серия Террона НЕ побеждена && Day>2000 && (Day mod (Day mod 11 + 20) == 0 || Day>4000) && программы нет.",
      "        AddDialogBlock(CT('FormRuins.PB.SabCrack.PlayerInfo'), 2);",
      "        if(PlayerMayTakeSubCrack())",
      "        {",
      "            t1 = DeleteTags(t0 + \"И что же такое интересное вы хотите мне продать?\");",
      "            //как в движке: денег меньше цены -> пункт серый некликабельный",
      "            if(ShipMoney(Player()) < SubCrackCost()) AddDialogBlock(t1, 1);",
      "            AddDialogInject('PB_SabCrack', '', t1, 1);",
      "        }",
      "        //--- SpecialShip: НЕ трогаем, ванильный пункт движка (флаг базы SpecialServiceActive, условия,",
      "        //    акриновый корпус SuperHullPB и смена отношений скриптом не воспроизводимы) ---",
      "        //--- WarStatus + AskQuestion (pirates only) ---",
      "        if(ShipInPirateClan(Player()))",
      "        {",
      "            AddDialogBlock(CT('FormRuins.PB.WarWithKlingAndCoalition.PlayerSend'), 2);",
      "            AddDialogInject('PB_WarStatus', '', DeleteTags(t0 + \"Как вообще обстановочка на фронтах?\"), 1);",
      "            AddDialogBlock(CT('FormRuins.PB.AskQuestion.PlayerAsk'), 2);",
      "            AddDialogInject('PB_AskQuestion', '', DeleteTags(t0 + \"Хочу спросить пару вопросов, как пират у пирата...\"), 1);",
      "        }",
      "    }",
      "}"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1610,
     "Pos.y": 20,
     "Parent": -1,
     "#": 138,
     "Code.Type": "Turn",
     "Code": [
      "sBack = '</color>' + CT('FormRuins.PB.Grouping.Back');",
      "dtext = '</color>' + Format(CT('FormRuins.PB.Grouping.ShopMsg'), '<Player'+'>', ShipName(Player()));",
      "dtext = Format(dtext);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1610,
     "Pos.y": 80,
     "Parent": -1,
     "#": 140,
     "Code.Type": "Turn",
     "Code": [
      "InjectAnswer('PB_Nod', DeleteTags(\"Мне нужны ноды\"), 0);",
      "InjectAnswer('PB_Program', DeleteTags(\"Хочу приобрести программы\"), 0);",
      "InjectAnswer('PB_Chameleon', DeleteTags(\"Я слышал, у вас есть камуфляжное устройство\"), 0);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1610,
     "Pos.y": 200,
     "Parent": -1,
     "#": 143,
     "Code.Type": "Turn",
     "Code": [
      "sBack = '</color>' + CT('FormRuins.PB.Grouping.Back');",
      "dtext = '</color>' + Format(CT('FormRuins.PB.Grouping.BodyModsMsg'), '<Player'+'>', ShipName(Player()));",
      "dtext = Format(dtext);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1610,
     "Pos.y": 260,
     "Parent": -1,
     "#": 145,
     "Code.Type": "Turn",
     "Code": [
      "InjectAnswer('PB_ChangeNationality', DeleteTags(\"Меня интересует смена подданства\"), 0);",
      "if(CurrentMods('Expansion\\\\ExpImplants')) InjectAnswer('Mod_ExpImplants:ImplantsPB', '</color>' + CT('FormRuins.PB.Grouping.Biomodules'), 0);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1460,
     "Pos.y": 80,
     "Parent": -1,
     "#": 150,
     "Code.Type": "Turn",
     "Code": [
      "n0 = round(min(GalaxyMoney(3, 0), GalaxyMoney(3, 1), GalaxyMoney(3, 2), GalaxyMoney(3, 3), GalaxyMoney(3, 4)) * g_NationalityFactor());",
      "//Как в движке: при нехватке денег даже на самую дешёвую расу согласие не срабатывает",
      "if(ShipMoney(Player()) >= n0) InjectAnswer('PB_ChangeNationality_Do', '</color>' + CT('FormRuins.PB.ChangeNationality.PlayerOk'), 1);",
      "else InjectAnswer('PB_ChangeNationality', '</color>' + CT('FormRuins.PB.ChangeNationality.PlayerOk'), 1);",
      "InjectAnswer('PB_ChangeNationality_No', '</color>' + CT('FormRuins.PB.ChangeNationality.PlayerNo'), 0);"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1760,
     "Pos.y": 20,
     "Parent": -1,
     "#": 152,
     "Code.Type": "Turn",
     "Code": [
      "OpenCustomForm('CustomForm_ExpPB_ChangeRace');"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1760,
     "Pos.y": 140,
     "Parent": -1,
     "#": 154,
     "Code.Type": "Turn",
     "Code": [
      "if(!CoalitionDefeated()) dtext = '</color>' + Format(CT('FormRuins.PB.ChangeNationality.PBAfterNo'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
      "else dtext = '</color>' + Format(CT('FormRuins.PB.ChangeNationality.PBAfterNoAlt'), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player()));",
      "dtext = Format(dtext);"
     ]
    }
