                    "Code": [
                        "RunChildForm('Galaxy');",
                        "if(ShipOrder(Player())==7) {",
                        "  ShipOrderData1(Player(),1);",
                        "  ForceNextDay();",
                        "  ButtonClick('Ship','Exit');",
                        "  ShipCustomShipInfoData(Player(),'RefSalamanderEnergy',1,0);",
                        "}"
                    ],
                    "#": 166
                }
