   "Operations": [
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 0,
     "Pos.y": 200,
     "Parent": -1,
     "#": 24,
     "Code.Type": "Global",
     "Code": [
      "if(!GCntRun(GScriptName)) GRun();"
     ]
    },
    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 0,
     "Pos.y": 230,
     "Parent": -1,
     "#": 25,
     "Code.Type": "Init",
     "Code": [
      "//Отладочный вывод отключён",
      "",
      "//--- Смена стороны и национальности на ПБ по формулам движка (TfRuinsTalk, пиратская база) ---",
      "//Движок не пишет галасобытия PlayerChangesSide/PlayerChangesNationality для смен через ExpPB,",
      "//поэтому ходы таких смен хранятся в ExpPB_SideChangeTurns/ExpPB_NatChangeTurns (элемент [0] - заглушка)",
      "function g_CountRecentChanges(str etype)",
      "{",
      "    int cnt = 0;",
      "    int k = 0;",
      "    for(k = GalaxyEvents() - 1; k >= 0; k = k - 1)",
      "    {",
      "        if(GalaxyEventDate(k) + 365 < CurTurn()) break;",
      "        if(GalaxyEventType(k) == etype) cnt = cnt + 1;",
      "    }",
      "    if(etype == 'PlayerChangesSide')",
      "    {",
      "        if(ArrayDim(ExpPB_SideChangeTurns) < 1) { free(ExpPB_SideChangeTurns); ExpPB_SideChangeTurns = newarray(1); ExpPB_SideChangeTurns[0] = 0; }",
      "        for(k = ArrayDim(ExpPB_SideChangeTurns) - 1; k >= 1; k = k - 1)",
      "        {",
      "            if(ExpPB_SideChangeTurns[k] + 365 < CurTurn()) ArrayDelete(ExpPB_SideChangeTurns, k);",
      "            else cnt = cnt + 1;",
      "        }",
      "    }",
      "    else",
      "    {",
      "        if(ArrayDim(ExpPB_NatChangeTurns) < 1) { free(ExpPB_NatChangeTurns); ExpPB_NatChangeTurns = newarray(1); ExpPB_NatChangeTurns[0] = 0; }",
      "        for(k = ArrayDim(ExpPB_NatChangeTurns) - 1; k >= 1; k = k - 1)",
      "        {",
      "            if(ExpPB_NatChangeTurns[k] + 365 < CurTurn()) ArrayDelete(ExpPB_NatChangeTurns, k);",
      "            else cnt = cnt + 1;",
      "        }",
      "    }",
      "    result = cnt;",
      "}",
      "",
      "//Запоминаем ход смены (аналог AddGalaxyEvent в движке)",
      "function g_RememberChange(str etype)",
      "{",
      "    g_CountRecentChanges(etype); //инициализация массива и чистка старых записей",
      "    if(etype == 'PlayerChangesSide') ArrayAdd(ExpPB_SideChangeTurns, CurTurn());",
      "    else ArrayAdd(ExpPB_NatChangeTurns, CurTurn());",
      "}",
      "",
      "//Цена смены стороны: огромная сумма, x1.5 за каждую смену за последние 365 дней, не больше 100000000",
      "function g_SideChangeCost()",
      "{",
      "    int cost = GalaxyMoney(4);",
      "    int cnt = g_CountRecentChanges('PlayerChangesSide');",
      "    for(int k = 0; k < cnt; k = k + 1) cost = min(100000000, round(cost * 1.5));",
      "    result = cost;",
      "}",
      "",
      "//Отношения после смены стороны (вызывать ПОСЛЕ смены овнера)",
      "function g_ApplySideChangeRelations()",
      "{",
      "    dword pc = PlanetPirateClan();",
      "    if(ShipOnSidePirateClan(Player()))",
      "    {",
      "        if(pc) { if(RelationToRanger(pc, Player()) < 45) RelationToRanger(pc, Player(), 45); }",
      "        ChangeGlobalRelationsShips(Player(), 0, 1, 45, 61, 128);",
      "        ChangeGlobalRelationsPlanets(Player(), 0, 0, 20, 31);",
      "        ChangeGlobalRelationsShips(Player(), 0, 0, 20, 61, 31);",
      "    }",
      "    else",
      "    {",
      "        ChangeGlobalRelationsPlanets(Player(), 0, 1, 45, 31);",
      "        ChangeGlobalRelationsShips(Player(), 0, 1, 45, 61, 31);",
      "        if(pc) { if(RelationToRanger(pc, Player()) > 20) RelationToRanger(pc, Player(), 20); }",
      "        ChangeGlobalRelationsShips(Player(), 0, 0, 20, 61, 128);",
      "    }",
      "}",
      "",
      "//Множитель цены смены национальности: x1.5 за каждую смену за последние 365 дней",
      "function g_NationalityFactor()",
      "{",
      "    float f = 1.0;",
      "    int cnt = g_CountRecentChanges('PlayerChangesNationality');",
      "    for(int k = 0; k < cnt; k = k + 1) f = f * 1.5;",
      "    result = f;",
      "}",
      "",
      "function g_NationalityCost(int race)",
      "{",
      "    result = round(GalaxyMoney(3, race) * g_NationalityFactor());",
      "}",
      "",
      "//Смена национальности (TfRuinsTalk.AcceptPirateBaseNationality), вызывается из CustomForm_ExpPB_ChangeRace",
      "function g_ApplyNationality(int race, int face, str nm)",
      "{",
      "    int ok = 0;",
      "    int cost = g_NationalityCost(race);",
      "    if(race >= 0 && race <= 4 && ShipMoney(Player()) >= cost)",
      "    {",
      "        ok = 1;",
      "        ShipPilotRace(Player(), race);",
      "        ShipFace(Player(), face);",
      "        //Пиратский овнер сохраняется, коалиционный меняется на новую расу",
      "        if(!ShipOnSidePirateClan(Player())) ShipOwner(Player(), race);",
      "        if(nm != '') SetName(Player(), nm);",
      "        ShipMoney(Player(), max(ShipMoney(Player()) - cost, 0));",
      "        //Недоразвившиеся болезни 1..12, которыми новая раса болеть не может, снимаются",
      "        //(маски рас CaptainHealthDefinitions[].AllowedOwners: бит 1 - малоки ... бит 16 - гаальцы)",
      "        str masks = '31,30,7,30,31,31,31,30,1,2,8,16';",
      "        for(int j = 1; j <= 12; j = j + 1)",
      "        {",
      "            int m = int(GetParFromString(masks, ',', j - 1, 0));",
      "            if((m & (1 << race)) == 0)",
      "            {",
      "                if(ShipHealthFactorStatus(Player(), j) < 100) ShipHealthFactorStatus(Player(), j, 0);",
      "            }",
      "        }",
      "        ChangeGlobalRelationsPlanets(Player(), 0, 1, 70, 31);",
      "        ChangeGlobalRelationsShips(Player(), 0, 1, 70, 61, 31);",
      "        dword pc = PlanetPirateClan();",
      "        if(pc) { if(RelationToRanger(pc, Player()) < 45) RelationToRanger(pc, Player(), 45); }",
      "        ChangeGlobalRelationsShips(Player(), 0, 1, 45, 61, 128);",
      "        Sound('Sound.Sell');",
      "        g_RememberChange('PlayerChangesNationality');",
      "        str rt = 'Maloc';",
      "        if(race == 1) rt = 'Peleng';",
      "        else if(race == 2) rt = 'People';",
      "        else if(race == 3) rt = 'Fei';",
      "        else if(race == 4) rt = 'Gaal';",
      "        MessageBox(Format(CT('FormRuins.PB.ChangeNationality.AfterOperation' + rt), '<Player'+'>', ShipName(Player()), '<CurName'+'>', ShipName(Player())), 10);",
      "    }",
      "    result = ok;",
      "}"
     ]
    },
