            "Operations": 
            [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 440,
                    "Parent": -1,
                    "#": 9,
                    "Code.Type": "Global",
                    "Code": 
                    [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 440,
                    "Parent": -1,
                    "#": 10,
                    "Code.Type": "DialogBegin",
                    "Code": 
                    [
                        "if(GetShipRuins(Player())) {",
                        "  if(ShipType(GetShipRuins(Player()))=='WB') {",
                        "    j=0;",
                        "    money=0;",
                        "    for(i=0;i<ShipItems(Player());i=i+1)",
                        "    {",
                        "        tdwd=ShipItems(Player(),i);",
                        "        if(ItemType(tdwd)!=t_UselessItem)continue;",
                        "        if(EquipmentImageName(tdwd)=='ExpCaravan_CargoBox')",
                        "        {",
                        "            j=j+1;",
                        "            money=money+ItemCost(tdwd);",
                        "        }",
                        "    }",
                        "    if(j)",
                        "    {",
                        "        if(j==1)Ttext='</color>'+\"Контейнер\";",
                        "        else Ttext='</color>'+\"Контейнеры\";",
                        "        money=money+(money*25)/400;",
                        "        AddDialogInject('WB_CargoBox','',\"Товарищ полковник, я здесь отбил в бою какие-то важные контейнера, не посмотрите, что это такое?\",1);",
                        "    }",
                        "  }",
                        "  if(ShipType(GetShipRuins(Player()))=='PB') {",
                        "    j=0;",
                        "    money=0;",
                        "    for(i=0;i<ShipItems(Player());i=i+1)",
                        "    {",
                        "        tdwd=ShipItems(Player(),i);",
                        "        if(ItemType(tdwd)!=t_UselessItem)continue;",
                        "        if(EquipmentImageName(tdwd)=='ExpCaravan_CargoBox')",
                        "        {",
                        "            j=j+1;",
                        "            money=money+ItemCost(tdwd);",
                        "        }",
                        "    }",
                        "    if(j)",
                        "    {",
                        "        if(j==1)Ttext='</color>'+\"Контейнер\";",
                        "        else Ttext='</color>'+\"Контейнеры\";",
                        "        money=money+(money*25)/100;",
                        "        AddDialogInject('PB_CargoBox','',\"Слышьте, где тут у вас сбарыжить можно непосильным трудом нажитое?\",1);",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 305,
                    "Parent": -1,
                    "#": 28,
                    "Code.Type": "Turn",
