            "Operations": [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 370,
                    "Pos.y": 230,
                    "Parent": -1,
                    "#": 5,
                    "Total.Lines": 6,
                    "Code.Type": "Init",
                    "Code": [
                        "//Универсальный MS_SB1 (UtilityFunctionsPack). Ветки для модов, которым он нужен:",
                        "//  Tweaks\\BlockPirates - в разговоре на научной базе нет пиратов: ответы без пиратов,",
                        "//    после вопроса о торговле сразу к рассказу о сети научных центров (тексты в Lang мода, ключи Script.MS_SB1.BP*)",
                        "//Без этих модов логика ванильная.",
                        "tStart = CurTurn();",
                        "EtherIdAdd('7B7EC91E-40D2-43A8-9DCC-085A81303549');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 370,
                    "Pos.y": 250,
                    "Parent": -1,
                    "#": 6,
                    "Total.Lines": 6,
                    "Code.Type": "Turn",
                    "Code": [
                        "if ((CurTurn() - tStart) > (365 * 2 + 150)) {",
                        "    if (EtherState('7B7EC91E-40D2-43A8-9DCC-085A81303549') == 3) {",
                        "        Ether(5, '7B7EC91E-40D2-43A8-9DCC-085A81303549', Format(CT('Script.MS_SB1.12'),'<0'+'>',ShortName(GroupToShip(grSB))), GroupToShip(grSB));",
                        "    }",
                        "    ShipOut(GroupToShip(grSB));",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 180,
                    "Parent": -1,
                    "#": 24,
                    "Total.Lines": 3,
                    "Code.Type": "Turn",
                    "Code": [
                        "MS_SB1_DialogOk = 1;",
                        "Ether(4, '7B7EC91E-40D2-43A8-9DCC-085A81303549', Format(CT('Script.MS_SB1.12'),'<0'+'>',ShortName(GroupToShip(grSB))), GroupToShip(grSB));",
                        "ShipOut(GroupToShip(grSB));",
                        "//Тексты сообщения и ответов (ванильные ключи Lang Script.MS_SB1.N)",
                        "tstr1 = '</color>' + CT('Script.MS_SB1.19');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 500,
                    "Pos.y": 180,
                    "Parent": -1,
                    "#": 27,
                    "Total.Lines": 1,
                    "Code.Type": "Turn",
                    "Code": [
                        "SkipGreeting();",
                        "//Тексты сообщения и ответов (ванильные ключи Lang Script.MS_SB1.N)",
                        "tstr1 = '</color>' + CT('Script.MS_SB1.0');",
                        "tstr2 = '</color>' + CT('Script.MS_SB1.6');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 560,
