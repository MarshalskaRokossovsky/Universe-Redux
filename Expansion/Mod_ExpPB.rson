    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 1330,
     "Pos.y": 20,
     "Parent": -1,
     "#": 132,
     "Code.Type": "Turn",
     "Code": [
      "n0 = GalaxyStars();",
      "n1 = 0; n2 = 0; n3 = 0;",
      "for(ii = 0; ii < n0; ii = ii + 1)",
      "{",
      "    dwd1 = StarOwner(GalaxyStar(ii));",
      "    if(dwd1 == 2) n1 = n1 + 1;",
      "    else if(dwd1 == 1) n2 = n2 + 1;",
      "    else if(dwd1 == 0) n3 = n3 + 1;",
      "}",
      "if(n0 < 1) n0 = 1;",
      "if(n2 == 0) t0 = 'CoalitionOnly';",
      "else if(CoalitionDefeated()) t0 = 'KlingOnly';",
      "else t0 = 'KlingAndCoalition';",
      "t1 = int(100 * n1 / n0);",
      "t2 = int(100 * n2 / n0);",
      "t3 = int(100 * n3 / n0);",
      "if(t1 >= 100) t4 = 'PBAnswerWeControl100Percent';",
      "else if(t1 > 90) t4 = 'PBAnswerWeControlMore90Percent';",
      "else if(t1 > 70) t4 = 'PBAnswerWeControlMore70Percent';",
      "else if(t1 > 50) t4 = 'PBAnswerWeControlMore50Percent';",
      "else if(t1 > 30) t4 = 'PBAnswerWeControlMore30Percent';",
      "else if(t1 > 10) t4 = 'PBAnswerWeControlMore10Percent';",
      "else t4 = 'PBAnswerWeControlMore00Percent';",
      "dtext = '</color>' + Format(CT('FormRuins.PB.WarWithKlingAndCoalition.' + t0 + '.' + t4), '<Player'+'>', ShipName(Player()), '<PiratesPercent'+'>', t1, '<DominatorsPercent'+'>', t2, '<Percent'+'>', t3);",
      "dtext = Format(dtext);"
     ]
    },
