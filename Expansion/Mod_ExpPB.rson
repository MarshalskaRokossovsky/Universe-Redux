    {
     "Type": "Top",
     "Name": "",
     "Pos.x": 870,
     "Pos.y": 20,
     "Parent": -1,
     "#": 79,
     "Code.Type": "Turn",
     "Code": [
      "n0 = 0;",
      "nraw = 0;",
      "n1 = 0;",
      "float fv;",
      "for(ii = 1; ii < ShipItems(Player()); ii = ii + 1)",
      "{",
      "    dwd1 = ShipItems(Player(), ii);",
      "    if(!ItemIsInUse(dwd1)) continue;",
      "    if(ItemType(dwd1) == t_Hull) continue;",
      "    if(ItemDurability(dwd1) >= 100) continue;",
      "    dwd2 = ItemSize(dwd1);",
      "    fv = 0.01 * (100 - ItemDurability(dwd1)) * (dwd2 / 7) + (dwd2 / 20) + 10;",
      "    n2 = int((fv + 5) / 10) * 10;",
      "    if(ItemType(dwd1) == t_Artefact || ItemType(dwd1) == t_Artefact2) n2 = n2 * 2;",
      "    if(EqCustomFaction(dwd1) == 'Klissan') { n1 = n1 + int((100 - ItemDurability(dwd1)) / 10) + 1; n2 = int(n2 * 1.3); }",
      "    nraw = nraw + n2;",
      "}",
      "n3 = int(1.0 * RangerStatus(Player()) / 1.3 + 0.5) + 1;",
      "n0 = nraw - int(0.01 * nraw * n3); if(n0 < 1 && n1 == 0) n0 = 0;",
      "if(n0 <= 0 && n1 <= 0) { dtext = '</color>' + 'Сейчас посмотрим...<br>...<br>Твой корабль, ' + ShipName(Player()) + ', в отличном состоянии. Он не требует ремонта.'; }",
      "else { dtext = '</color>' + 'Сейчас оценим стоимость ремонта...<br>...<br>' + 'Так, так... Наши расценки составят ' + nraw + ' cr. Твой пиратский рейтинг ' + n3 + '%. Значит, с учетом нашей скидки, цена составит ' + n0 + ' cr.<br>';",
      "       if(n1 > 0) dtext = dtext + '----------------------<br>Да, чуть не забыл. У тебя на корабле установлено оружие доминаторов. И как ты, наверное, уже знаешь, для его починки нужны ноды. Скажем, ' + n1 + ' нд. нам хватит.<br>';",
      "       dtext = dtext + 'Ремонтировать?'; }",
      "dtext = Format(dtext);"
     ]
    },
